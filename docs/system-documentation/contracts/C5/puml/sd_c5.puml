@startuml sd_c5
skinparam backgroundColor #FFFFFF
title C5 - Copy of a flight to airports-routes
autonumber
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
participant "flight-ops-n\n(replica of the caller)" as Caller
participant "airports-routes-local\n(Envoy of the same machine)" as Entry
box "airports-routes-k (a ready replica)" #F7F7F7
participant "FlightCopyController" as Ctrl
participant "RecordFlightCopyUseCase" as UC
database "own database" as DB
end box
collections "peer replicas\nairports-routes-m" as Peers
Caller -> Entry : PUT /internal/flights/{id}\n(Authorization: actor's JWT or service token;\nX-Correlation-Id)
Entry -> Ctrl : to a ready replica\n(another one if it fails)
Ctrl -> UC : execute(...)
UC -> DB : copy with this id already stored?
alt same or newer version already stored
Ctrl --> Entry : 200 (idempotent, nothing changes)
else new copy
UC -> DB : find route
opt not held here
UC -> Peers : GET /internal/routes/{origin}/{destination}
Peers --> UC : 200 / 404
end
alt route unknown
Ctrl --> Entry : 404
else route cannot take the flight
Ctrl --> Entry : 409
else accepted
UC -> DB : save copy + copy for the next replica in the outbox\n(same transaction)
Ctrl --> Entry : 200
end
end
Entry --> Caller : answer
note over Caller : 404, 409 or no answer: flight-ops undoes the scheduling;\na cancellation that is not delivered is retried every 5 s
@enduml
