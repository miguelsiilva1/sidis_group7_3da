@startuml sd_us206
skinparam backgroundColor #FFFFFF
title US206 - Sequence Diagram
autonumber
skinparam sequenceMessageAlign center
skinparam maxMessageSize 260
actor "ATCC" as Actor
participant "Entry (Envoy)\nvirtual IP of aircraft-maintenance" as EAM
box "aircraft-maintenance-n (the replica that answers)" #F7F7F7
participant "AircraftController" as AircraftController
participant "CalculateAircraftOperationalHoursUseCase" as CalculateAircraftOperationalHoursUseCase
database "own database" as DBAM
end box
collections "peer replicas\naircraft-maintenance-m" as PAM
== GET /api/aircrafts/{registration}/operational-hours ==
Actor -> EAM : GET /api/aircrafts/{registration}/operational-hours\n(HTTPS, Authorization: Bearer JWT)
EAM -> AircraftController : to a ready replica\n(another one if it fails)
AircraftController -> CalculateAircraftOperationalHoursUseCase : execute(...)
CalculateAircraftOperationalHoursUseCase -> DBAM : own aircraft
CalculateAircraftOperationalHoursUseCase -> PAM : GET /internal/replicas/aircrafts\n(every peer in parallel)
PAM --> CalculateAircraftOperationalHoursUseCase : their aircraft
CalculateAircraftOperationalHoursUseCase -> DBAM : own copies of the flights (sent by flight-ops)
CalculateAircraftOperationalHoursUseCase -> PAM : GET /internal/replicas/flight-copies\n(every peer in parallel)
PAM --> CalculateAircraftOperationalHoursUseCase : their copies of the flights (sent by flight-ops)
CalculateAircraftOperationalHoursUseCase -> CalculateAircraftOperationalHoursUseCase : keep the latest change of each record,\nleave out deleted ones; filter, compute, sort, page
CalculateAircraftOperationalHoursUseCase --> AircraftController : result
AircraftController --> Actor : 200 OK (X-Node-Id; X-Partial-Result if both holders of a record were unreachable)
@enduml
