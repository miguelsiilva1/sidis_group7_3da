@startuml sd_us225
skinparam backgroundColor #FFFFFF
title US225 - Sequence Diagram
autonumber
skinparam sequenceMessageAlign center
skinparam maxMessageSize 260
actor "Backoffice Operator" as Actor
participant "Entry (Envoy)\nvirtual IP of aircraft-maintenance" as EAM
box "aircraft-maintenance-n (the replica that answers)" #F7F7F7
participant "AircraftModelController" as AircraftModelController
participant "AircraftController" as AircraftController
participant "MaintenanceController" as MaintenanceController
participant "ImportAircraftModelsUseCase" as ImportAircraftModelsUseCase
participant "ImportAircraftsUseCase" as ImportAircraftsUseCase
participant "ImportMaintenanceTemplatesUseCase" as ImportMaintenanceTemplatesUseCase
participant "ImportMaintenancePartsUseCase" as ImportMaintenancePartsUseCase
participant "ImportMaintenanceRecordsUseCase" as ImportMaintenanceRecordsUseCase
database "own database" as DBAM
participant "Outbox dispatcher" as OBAM
end box
collections "peer replicas\naircraft-maintenance-m" as PAM
participant "Entry (Envoy)\nvirtual IP of airports-routes" as EAR
box "airports-routes-n (the replica that answers)" #F7F7F7
participant "AirportController" as AirportController
participant "RouteController" as RouteController
participant "ImportAirportsUseCase" as ImportAirportsUseCase
participant "ImportRoutesUseCase" as ImportRoutesUseCase
database "own database" as DBAR
participant "Outbox dispatcher" as OBAR
end box
collections "peer replicas\nairports-routes-m" as PAR
participant "Entry (Envoy)\nvirtual IP of flight-ops" as EFO
box "flight-ops-n (the replica that answers)" #F7F7F7
participant "FlightController" as FlightController
participant "ImportFlightsUseCase" as ImportFlightsUseCase
database "own database" as DBFO
participant "Outbox dispatcher" as OBFO
end box
collections "peer replicas\nflight-ops-m" as PFO
== POST /api/aircraftModels/import ==
Actor -> EAM : POST /api/aircraftModels/import\n(HTTPS, Authorization: Bearer JWT)
EAM -> AircraftModelController : to a ready replica\n(another one if it fails)
AircraftModelController -> ImportAircraftModelsUseCase : execute(...)
loop each row of the CSV file
ImportAircraftModelsUseCase -> ImportAircraftModelsUseCase : RegisterAircraftModelUseCase.execute(row)\n(stored, and copied to every replica by the outbox)
end
ImportAircraftModelsUseCase --> AircraftModelController : rows created, row errors
AircraftModelController --> Actor : 201, or 207 with the result of each row
