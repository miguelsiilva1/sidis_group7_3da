@startuml ssd_us112
skinparam backgroundColor #FFFFFF
title US112 - System Sequence Diagram
autonumber
actor "ATCC" as Actor
participant "AISafe\nairports-routes\n(virtual IP 192.168.124.26, HTTPS)" as AR
